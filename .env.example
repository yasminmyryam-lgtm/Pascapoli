# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
#
# CLIENT-SAFE  ────────────────────────────────────────────────────────────────
# Vite inlines every VITE_* variable into the browser bundle. Only put values
# here that are safe to publish. The Supabase anon key is designed for this;
# the service-role key is NOT and must never gain a VITE_ prefix.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Used to build shareable invite links (Phase 3).
VITE_PUBLIC_BASE_URL=http://localhost:8443

# Authoritative Colyseus game server (Phase 3).
# Dev: ws://localhost:2567   Production: wss://<app>.fly.dev
VITE_GAME_SERVER_URL=ws://localhost:2567

# HTTP economy API (diamond revives + payout doubling). Empty = same origin.
# Local: leave empty while Vite is on 8443 (client falls back). Production: the Node server.
VITE_ECONOMY_API_URL=

# SERVER-ONLY  ────────────────────────────────────────────────────────────────
# These live in the game server process only (`fly secrets set ...`).
# They must never appear in the frontend bundle or in a VITE_* variable.

# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_JWT_SECRET=your-jwt-secret
# PORT=8443
# ALLOWED_ORIGINS=http://localhost:8443
